.DS_Store
Thumbs.db
desktop.ini

# Obsidian vault config (user-specific)
.obsidian/

# Temp/scratch
Untitled*
*.base
*.canvas
screenshot-*.png
scripts/*.log
node_modules/
.npm-cache/
